{
  "name": "other-lives",
  "version": "6.2.0-rc.2",
  "private": true,
  "description": "Buildless, browser-local life simulation with a dependency-free QA suite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node scripts/test.cjs",
    "test:simulation": "node tests/simulation/run.cjs --lives 1000",
    "test:smoke": "node tests/simulation/run.cjs --lives 40",
    "test:release": "npm test && npm run test:simulation",
    "build": "node scripts/build.cjs"
  }
}
